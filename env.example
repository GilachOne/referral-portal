# Скопируйте в app/.env и заполните. Файл не должен попадать в git и в веб-корень.

# --- Адрес кабинета ---
APP_BASE_URL=https://referral.example.com

# --- Битрикс24 ---
# входящий вебхук (скоупы crm, tasks)
BITRIX_WEBHOOK=
# пароль для исходящего вебхука из Битрикса в /hook/bitrix
BITRIX_HOOK_TOKEN=

# --- Вход звонком (zvonok.com) ---
ZVONOK_PUBLIC_KEY=
ZVONOK_CAMPAIGN_ID=
ZVONOK_CONFIRM_CAMPAIGN_ID=

# --- Web Push (VAPID) ---
VAPID_PUBLIC=
VAPID_PRIVATE_PEM=
VAPID_SUBJECT=mailto:admin@example.com

# --- Журнал событий (PostgreSQL) ---
PGDSN=pgsql:host=localhost;dbname=events
PGUSER=
PGPASS=

# --- Чат-боты LeadTeh ---
LEADTEH_TOKEN=
LEADTEH_BOTS=

# --- Google-таблица с расходами на рекламу ---
MARKETING_SHEET_ID=

# --- Сквозной вход из портала сотрудников ---
REF_SSO_SECRET=

# --- Программа ---
# телефоны администраторов через запятую
REF_ADMINS=
# тестовые участники, их не считаем в аналитике
REF_TEST_PHONES=
# лимит выплат в месяц, 0 — без лимита
REF_BUDGET_MONTH=0

# Проверка реферера в учётной системе школы — отдельный файл app/ashk.env:
#   ASHK_API_URL=https://crm.example.com/api
#   ASHK_API_KEY=
